{
  "manifest_version": 3,
  "name": "WordHarvest: Translate, Dictionary & Vocabulary Flashcards",
  "short_name": "WordHarvest",
  "version": "1.1.0",
  "description": "Pop-up translator and dictionary: double-click any word to translate it, save it, and master it with fun, game-like lessons.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "WordHarvest",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.mymemory.translated.net/*"]
}
