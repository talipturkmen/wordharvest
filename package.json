{
  "name": "wordle",
  "private": true,
  "description": "Context Cards — a Chrome extension: double-click a word to translate it, save it with its sentence, review it as spaced-repetition flashcards.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "zip": "node scripts/zip.mjs",
    "package": "npm run typecheck && npm test && npm run build && npm run zip",
    "store-assets": "npm run build && node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2"
  }
}
